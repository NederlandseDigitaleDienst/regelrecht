{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wetsproces",
  "version": "0.1.0",
  "identifier": "nl.regelrecht.wetsproces.app",
  "build": {
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [
      {
        "title": "Wetsproces",
        "url": "burger.html",
        "width": 480,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
