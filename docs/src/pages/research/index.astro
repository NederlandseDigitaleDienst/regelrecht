---
/*
 * Research overview: papers and other research output around RegelRecht.
 * Intro left, cards right: a paper carries a kind, its authors, a date and the
 * opening of its abstract, which is more than a list row can carry. The card is
 * the same LinkCard the landing page renders for this paper.
 */
import Base from '~/layouts/Base.astro';
import LinkCard from '~/components/LinkCard.astro';
import paper from '~/research/rules-as-executed.meta.json';
import jurixPaper from '~/research/citizen-explanation.meta.json';
import promisedPaper from '~/research/rules-as-promised.meta.json';
import { joinAuthors } from '~/lib/authors';

const pathname = '/research/';

interface ResearchItem {
  title: string;
  meta: string;
  text: string;
  href: string;
  linkLabel: string;
}

const items: ResearchItem[] = [
  {
    title: `${paper.title}: ${paper.subtitle}`,
    meta: `${paper.kind} • ${paper.authors.join(' and ')} • ${paper.date_display}`,
    // Opening of the abstract, verbatim (generated with the paper HTML).
    text: paper.abstract_lead,
    href: '/research/rules-as-executed',
    linkLabel: 'position paper',
  },
  {
    title: `${jurixPaper.title}: ${jurixPaper.subtitle}`,
    meta: `${jurixPaper.venue} paper • ${joinAuthors(jurixPaper.authors.map((a) => a.name))} • ${jurixPaper.date_display}`,
    // Opening of the abstract, verbatim (generated with the paper HTML).
    text: jurixPaper.abstract_lead,
    href: '/research/citizen-explanation',
    linkLabel: 'paper',
  },
  {
    title: promisedPaper.title,
    meta: `${promisedPaper.venue} paper • ${joinAuthors(promisedPaper.authors.map((a) => a.name))} • ${promisedPaper.date_display}`,
    // Opening of the abstract, verbatim (generated with the paper HTML).
    text: promisedPaper.abstract_lead,
    href: '/research/rules-as-promised',
    linkLabel: 'paper',
  },
  {
    title: 'Rules as Executed: When machine-executable laws are published',
    meta: 'JURIX 2026 tutorial • Anne Schuth and Eelco Hotting • 8 December 2026',
    text: 'Ninety minutes with the demo in front of a room of researchers in law and computer science. We open Dutch statutes next to their executable specification, turn a threshold and watch who loses an allowance. Being argued with is the point.',
    href: '/research/jurix-2026-tutorial',
    linkLabel: 'about the tutorial',
  },
];
---

<Base
  lang="en"
  kind="docs"
  pathname={pathname}
  title="Research · RegelRecht"
  description="Research output around RegelRecht: papers on machine-executable law."
>
  <nldd-one-third-two-thirds-section
    sm-padding-bottom="32"
    md-padding-bottom="64"
    lg-padding-bottom="96"
  >
    <nldd-container slot="left">
      <nldd-title size="display-2">
        <h1>Research</h1>
      </nldd-title>
      <nldd-spacer />
      <nldd-rich-text>
        <p>
          Research output around RegelRecht: the thinking behind publishing
          machine-executable law, written up for an academic audience.
        </p>
      </nldd-rich-text>
    </nldd-container>
    <nldd-collection slot="right" layout="grid" item-min-width="320px">
      {items.map((item) => <LinkCard lang="en" tinted headingLevel={2} {...item} />)}
    </nldd-collection>
  </nldd-one-third-two-thirds-section>
</Base>
