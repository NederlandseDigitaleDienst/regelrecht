---
/*
 * /roadmap/werkpakket/<slug> — one werkpakket.
 *
 * Keyed on the frontmatter `id`, not on the filename: samenhangIds point at
 * that value, so keying on it makes the cross-links correct by construction.
 * (The two are equal — assertReferencesResolve enforces it — but the id is the
 * identity and the filename follows it, not the other way round.)
 *
 * That id is a slug, and used to be a UUID. A slug survives here where a
 * *title-derived* slug could not: it is chosen once and then fixed, so editing
 * a titel does not move the URL or break the samenhangIds pointing at it.
 * What it buys is a readable reference — in the URL, in the content directory,
 * and in a pull request that says which werkpakket it contributes to.
 *
 * Built entirely from design-system components: nldd-sidebar-section for the
 * document layout (it collapses the sidebar into a sheet on narrow screens by
 * itself), nldd-description-cell for the metadata pairs, nldd-text for every
 * run of text. No layout CSS and no media queries live here — the components
 * are responsive, so writing our own would fight them.
 *
 * Section headings are <h2> under the page <h1>. The app used <h3> here, which
 * check-heading-order.mjs rejects as a rank skip; nldd-title's `size` carries
 * the visual weight instead.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import EditLink from '~/components/EditLink.astro';
import {
  getFase,
  getDiscipline,
  getPrioriteit,
  getCategorie,
  getCapability,
  assertReferencesResolve,
  assertPaperSections,
  assertRfcReferences,
  onderzoeksvraagLijst,
  rfcVerwijzingen,
  getOnderzoek,
  getBouw,
  getBelegging,
  sindsTekst,
  assertBelegging,
  NIET_BEPAALD,
  NIET_GESPECIFICEERD,
} from '~/lib/roadmap';
import {
  renderMarkdown,
  yamlSequenceItemLines,
} from '~/lib/roadmap-markdown';

export async function getStaticPaths() {
  const werkpakketten = await getCollection('werkpakketten');
  assertReferencesResolve(werkpakketten);
  // Fails the build on a question pointing at a paper section that is gone.
  assertPaperSections(werkpakketten);
  // Fails the build on a werkpakket pointing at an RFC that does not exist.
  assertRfcReferences(werkpakketten);
  // Fails the build on a belegging that contradicts onderzoek/bouw, or that
  // claims a date in the future.
  assertBelegging(werkpakketten);
  return werkpakketten.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry, all: werkpakketten },
  }));
}

const { entry, all } = Astro.props;
const wp = entry.data;

const fase = getFase(wp.faseId);
const discipline = getDiscipline(wp.disciplineId);
const prioriteit = getPrioriteit(wp.prioriteit);
const categorie = getCategorie(wp.categorie);
const capability = getCapability(wp.capability);

const samenhang = wp.samenhangIds
  .map((id: string) => all.find((w) => w.data.id === id))
  .filter(Boolean);

// Both directions of the dependency, because both are things you need to know
// before you plan: what this werkpakket waits for, and what waits for it. Only
// the first is written down anywhere; the second is that same field read the
// other way round, so it cannot drift.
const wachtOp = wp.afhankelijkVan
  .map((id: string) => all.find((w) => w.data.id === id))
  .filter(Boolean);
const blokkeert = all.filter((w) => w.data.afhankelijkVan.includes(wp.id));

// The absolute path of the source file, so the toelichting's markdown can be
// stamped with the line numbers the select-to-edit affordance reads.
// entry.filePath is relative to the docs/ project root, which is where the
// build runs, so resolving against cwd lands on the real file.
const sourcePath = entry.filePath
  ? `${process.cwd()}/${entry.filePath}`
  : undefined;

// Both forms of a research question — plain text, or text plus a paper
// section — come out of this as one shape.
const vragen = onderzoeksvraagLijst(wp.onderzoeksvragen);

const toelichting = renderMarkdown(
  wp.toelichting,
  sourcePath ? { filePath: sourcePath, field: 'toelichting' } : undefined,
);

// The onderzoeksvragen are a YAML sequence, not markdown, so they carry no
// positions of their own; read their line ranges from the file so selecting
// one offers the same edit link as the toelichting.
const vraagRegels = sourcePath
  ? yamlSequenceItemLines(sourcePath, 'onderzoeksvragen')
  : [];

// Base.astro's select-to-edit button builds its URL from this attribute plus
// the data-line values above; the same wiring the docs and RFC pages use.
const editBase = entry.filePath
  ? `https://github.com/NederlandseDigitaleDienst/regelrecht/edit/main/docs/${entry.filePath}`
  : undefined;

const pathname = `/roadmap/werkpakket/${wp.id}`;

/*
 * The pull requests that carry this werkpakket's slug.
 *
 * Every PR body ends with a `Werkpakket: <slug>` line, which the merge gate
 * enforces, so GitHub's own search over PR bodies is the index — no label per
 * werkpakket to create, apply and keep aligned with a rename.
 *
 * Two forms, because the line has two lives. The author writes the bare slug;
 * script/linkify-werkpakket.sh then rewrites it to a markdown link, and the
 * literal `Werkpakket: <slug>` is gone from the body after that. Searching only
 * the bare form would find the PRs the bot did NOT touch (forks, Dependabot) and
 * miss the team's own — an empty page that reads as "no work yet" rather than
 * "wrong query". Searching only the link form would miss those same exceptions.
 *
 * The URL form keeps the closing paren so `referentie-casus-i` does not also
 * match `referentie-casus-ii`. Both phrases are quoted so GitHub matches them
 * whole; unquoted they would match every PR containing the word "werkpakket".
 *
 * This query tracks linkify's output format: change the shape the bot writes and
 * this has to change with it.
 */
const prZoekUrl = `https://github.com/NederlandseDigitaleDienst/regelrecht/pulls?q=${encodeURIComponent(
  `is:pr "werkpakket/${wp.id})" OR "Werkpakket: ${wp.id}"`,
)}`;

// The RFCs whose design work belongs here. Their implementation state comes
// from the RFC itself, so it cannot drift from what was actually decided.
const rfcs = rfcVerwijzingen(wp.rfcs);

const belegging = getBelegging(wp.belegging.stand);

// The metadata pairs, so the sidebar is one loop instead of five near-copies.
const kerngegevens = [
  // Bovenaan, want of er iemand op zit is het eerste wat je wilt weten als je
  // op een werkpakket landt. `onder` is de ouderdom: een kale datum leest als
  // metadata, "sinds 3 maanden" leest als een vraag.
  {
    label: 'Belegging',
    tag: belegging,
    value: '',
    onder: wp.belegging.sinds
      ? `sinds ${sindsTekst(wp.belegging.sinds)}`
      : undefined,
    // Geen `leeg`: getBelegging() leest een leeg veld als 'vrij', dus er is
    // altijd een tag. "Niet bepaald" zou hier een vierde stand suggereren die
    // niet bestaat.
  },
  { label: 'Onderzoek', tag: getOnderzoek(wp.onderzoek), value: '' },
  { label: 'Bouw', tag: getBouw(wp.bouw), value: '' },
  { label: 'Prioriteit', tag: prioriteit, value: '' },
  { label: 'Geschatte omvang', value: wp.omvang, leeg: NIET_BEPAALD },
  { label: 'Categorie', value: categorie?.label, leeg: NIET_BEPAALD },
  { label: 'Capability', value: capability?.label, leeg: NIET_BEPAALD },
  {
    label: 'Benodigde capaciteit',
    value: wp.capaciteit,
    leeg: NIET_GESPECIFICEERD,
  },
];
---

<Base
  lang="nl"
  kind="docs"
  pathname={pathname}
  noSearchIndex
  title={`${wp.titel} · Roadmap · RegelRecht`}
  description={`Werkpakket ${wp.titel} in de RegelRecht-roadmap.`}
>
  {/*
    no-collapse is load-bearing, not decoration. Without it the section turns
    the sidebar into a sheet below 1008px and leaves the trigger to the
    consumer — and a page with no client script has none, so every bit of
    metadata and the edit link were simply absent on phone and tablet.
    Stacking is what this page wants anyway: the metadata is short and there
    is no sticky chrome to escape.
  */}
  <nldd-sidebar-section
    no-collapse
    sidebar-label="Kerngegevens"
    sm-padding-bottom="32"
    md-padding-bottom="64"
    lg-padding-bottom="96"
  >
    <nldd-title slot="header" size="display-1">
      <h1>{wp.titel}</h1>
      <p slot="supporting-text">
        {[
          fase && (fase.ondertitel ? `${fase.naam} · ${fase.ondertitel}` : fase.naam),
          discipline?.naam,
        ]
          .filter(Boolean)
          .join(' · ')}
      </p>
    </nldd-title>

    <nldd-container slot="sidebar" padding="16" gap="16">
      {/* A stack of label/value pairs. nldd-description-cell is a table and
          list cell: standalone it has no width context and collapses to zero
          height, so the pair is an nldd-container of two nldd-texts. */}
      <nldd-container gap="16">
        {
          kerngegevens.map((veld) => (
            <nldd-container gap="2">
              <nldd-text size="xs" weight="medium" color="secondary">
                {veld.label}
              </nldd-text>
              {veld.tag ? (
                <nldd-container layout="wrap" gap="4">
                  <nldd-tag
                    color={veld.tag.tagColor}
                    text={veld.tag.label}
                    size="sm"
                  />
                </nldd-container>
              ) : (
                <nldd-text
                  size="sm"
                  color={veld.value ? 'content' : 'secondary'}
                >
                  {veld.value || veld.leeg || NIET_BEPAALD}
                </nldd-text>
              )}
              {/* Een stille tweede regel onder de tag. Alleen de belegging
                  gebruikt hem, voor de ouderdom van de claim. */}
              {veld.onder && (
                <nldd-text size="xs" color="secondary">{veld.onder}</nldd-text>
              )}
            </nldd-container>
          ))
        }
      </nldd-container>

      <nldd-divider />

      <EditLink filePath={entry.filePath} text="Bewerk op GitHub" />

      {/* Het werk dat bij dit werkpakket hoort, op GitHub.

          Dit leunt op de `Werkpakket: <slug>`-regel die elke pull request
          draagt (script/require-werkpakket.sh bewaakt hem) en op het feit dat
          de zoekfunctie van GitHub de body van een PR indexeert. Daarom zijn er
          geen labels per werkpakket nodig: die zouden een tweede waarheid zijn
          die bij elke hernoeming uit de pas loopt met de regel in de body.

          De zoekopdracht staat tussen aanhalingstekens, anders zoekt GitHub op
          de losse woorden en komt elke PR terug die "werkpakket" noemt. */}
      <nldd-link
        size="sm"
        href={prZoekUrl}
        target="_blank"
        text="Pull requests op GitHub"
      />
    </nldd-container>

    <nldd-container gap="32" data-edit-base={editBase}>
      <nldd-container gap="12">
        <nldd-title size="display-4"><h2>Onderzoeksvragen</h2></nldd-title>
        {
          vragen.length ? (
            <nldd-rich-text>
              <ol>
                {vragen.map((v, i) => (
                  <li
                    data-line={vraagRegels[i]?.[0]}
                    data-line-end={vraagRegels[i]?.[1]}
                  >
                    {v.vraag}
                    {/* On its own line, and short: the reference is a pointer,
                        not part of the sentence. The section title would be a
                        second English clause after every Dutch question, and
                        the paper's own name repeated per item drowned out the
                        questions. The full title is on the link's target. */}
                    {v.paper && (
                      <a class="rr-papersectie" href={v.paper.href}>
                        Rules as Executed §&nbsp;{v.paper.nummer}
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </nldd-rich-text>
          ) : (
            <nldd-text size="sm" color="secondary">
              Nog geen onderzoeksvragen geregistreerd.
            </nldd-text>
          )
        }
      </nldd-container>

      <nldd-container gap="12">
        <nldd-title size="display-4"><h2>Toelichting</h2></nldd-title>
        {
          toelichting ? (
            <nldd-rich-text>
              <Fragment set:html={toelichting} />
            </nldd-rich-text>
          ) : (
            <nldd-text size="sm" color="secondary">
              Geen toelichting toegevoegd.
            </nldd-text>
          )
        }
      </nldd-container>

      {
        rfcs.length > 0 && (
          <nldd-container gap="12">
            <nldd-title size="display-4">
              <h2>Ontwerp en implementatie</h2>
            </nldd-title>
            <nldd-list type="navigation" appearance="box-tinted">
              {rfcs.map((rfc) => (
                <nldd-list-item href={rfc.link}>
                  {/* The implementation state renders as a tag, the same
                      treatment /rfcs gives the same field. A bare string here
                      would have the site showing one value two ways. */}
                  <nldd-text-cell overline={rfc.id} text={rfc.title} width="full">
                    <nldd-container slot="supporting-text" layout="wrap" gap="4">
                      <nldd-tag color="neutral" size="md">
                        {rfc.implementation}
                      </nldd-tag>
                    </nldd-container>
                  </nldd-text-cell>
                  <nldd-spacer-cell />
                  <nldd-icon-cell size="20" icon="chevron-right" />
                </nldd-list-item>
              ))}
            </nldd-list>
          </nldd-container>
        )
      }

      {
        (wachtOp.length > 0 || blokkeert.length > 0) && (
          <nldd-container gap="12">
            <nldd-title size="display-4"><h2>Afhankelijkheden</h2></nldd-title>
            {wachtOp.length > 0 && (
              <nldd-container gap="8">
                <nldd-text size="sm" weight="medium" color="secondary">
                  Kan pas beginnen als dit opgeleverd is
                </nldd-text>
                <nldd-list type="navigation" appearance="box-tinted">
                  {wachtOp.map((related) => (
                    <nldd-list-item href={`/roadmap/werkpakket/${related!.data.id}`}>
                      <nldd-text-cell
                        text={related!.data.titel}
                        supporting-text={[
                          getFase(related!.data.faseId)?.naam,
                          getDiscipline(related!.data.disciplineId)?.naam,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                        width="full"
                      />
                      <nldd-spacer-cell />
                      <nldd-icon-cell size="20" icon="chevron-right" />
                    </nldd-list-item>
                  ))}
                </nldd-list>
              </nldd-container>
            )}
            {blokkeert.length > 0 && (
              <nldd-container gap="8">
                <nldd-text size="sm" weight="medium" color="secondary">
                  Wacht op dit werkpakket
                </nldd-text>
                <nldd-list type="navigation" appearance="box-tinted">
                  {blokkeert.map((related) => (
                    <nldd-list-item href={`/roadmap/werkpakket/${related.data.id}`}>
                      <nldd-text-cell
                        text={related.data.titel}
                        supporting-text={[
                          getFase(related.data.faseId)?.naam,
                          getDiscipline(related.data.disciplineId)?.naam,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                        width="full"
                      />
                      <nldd-spacer-cell />
                      <nldd-icon-cell size="20" icon="chevron-right" />
                    </nldd-list-item>
                  ))}
                </nldd-list>
              </nldd-container>
            )}
          </nldd-container>
        )
      }

      <nldd-container gap="12">
        <nldd-title size="display-4"><h2>Samenhang</h2></nldd-title>
        {
          samenhang.length ? (
            <nldd-list type="navigation" appearance="box-tinted">
              {samenhang.map((related) => {
                const relatedFase = getFase(related!.data.faseId);
                const relatedDiscipline = getDiscipline(
                  related!.data.disciplineId,
                );
                return (
                  <nldd-list-item
                    href={`/roadmap/werkpakket/${related!.data.id}`}
                  >
                    <nldd-text-cell
                      text={related!.data.titel}
                      supporting-text={[
                        relatedFase?.naam,
                        relatedDiscipline?.naam,
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                      width="full"
                    />
                    <nldd-spacer-cell />
                    <nldd-icon-cell size="20" icon="chevron-right" />
                  </nldd-list-item>
                );
              })}
            </nldd-list>
          ) : (
            <nldd-text size="sm" color="secondary">
              Geen samenhang met andere werkpakketten geregistreerd.
            </nldd-text>
          )
        }
      </nldd-container>
    </nldd-container>
  </nldd-sidebar-section>
</Base>

<style>
  /*
   * The paper reference under a research question. Scoped to this page rather
   * than living in roadmap.css: that stylesheet is imported by the matrix page
   * and scopes everything under .rr-roadmap, which this page does not have.
   *
   * On its own line and visually quieter than the question. Running it on
   * after the question mark made every item wrap into a second line of blue
   * and buried the question itself; it is a pointer, not part of the sentence.
   */
  .rr-papersectie {
    display: block;
    width: fit-content;
    margin-top: var(--primitives-space-4, 0.25rem);
    font: var(--primitives-font-body-xs-regular-snug, inherit);
    color: var(--semantics-content-secondary-color);
    text-decoration-color: var(--semantics-surfaces-tinted-border-color);
  }

  .rr-papersectie:hover,
  .rr-papersectie:focus-visible {
    color: var(--semantics-content-accent-color);
    text-decoration-color: currentColor;
  }
</style>
