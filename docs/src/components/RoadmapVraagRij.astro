---
/*
 * Eén onderzoeksvraag als kaart op de vragenpagina, uit te klappen tot een
 * mini-kanbanbord met zijn deelvragen.
 *
 * Dezelfde opbouw als RoadmapWerkpakketRij.astro: een eigen omlijste
 * nldd-list van het type `tree` met één tak, de rij als knop, en in de
 * `children`-slot één rij met het uitgeklapte deel: het doel, het mini-bord
 * met de deelvragen in vrij, opgepakt en klaar (een deelvraag zonder eigen
 * status volgt de lane van deze vraag), de user stories in
 * prioriteitsvolgorde (RoadmapStoryLijst), en de verwante vragen. Het
 * werkpakket en de papersectie staan als klikbare segmenten op de kaart zelf.
 *
 * De stories staan vóór de deelvragen: de deelvragen zijn de stappen van het
 * onderzoek, de stories zijn wat er voor de gebruiker moet komen te staan,
 * en dat laatste is waar het team op prioriteert.
 *
 * De data-attributen voor zoeken en het standfilter staan op de lijst, niet
 * op de rij, om dezelfde reden als bij de werkpakketrij.
 */
import RoadmapMiniBord from '~/components/RoadmapMiniBord.astro';
import RoadmapStoryLijst from '~/components/RoadmapStoryLijst.astro';
import {
  getOnderzoek,
  storiesTekst,
  getBelegging,
  vraagLane,
  deelvraagLane,
  vraagZoektekst,
  werkpakketTags,
  rfcTekst,
  type MiniTicket,
  type Onderzoeksvraag,
  type VraagVerwijzing,
  type WerkpakketData,
} from '~/lib/roadmap';

interface Props {
  vraag: Onderzoeksvraag;
  werkpakket: WerkpakketData;
  verwanten: Map<string, VraagVerwijzing[]>;
  /** De paragraaftegel waar deze vraag onder hoort; zie de schakelaar op de pagina. */
  paragraaf?: string;
}

const { vraag, werkpakket, verwanten, paragraaf } = Astro.props;

const { lane, eigen } = vraagLane(vraag, werkpakket);
const status = getOnderzoek(vraag.status);
const belegging = getBelegging(werkpakket.belegging.stand);
const tags = werkpakketTags(werkpakket);
const rfcs = rfcTekst(werkpakket);
const verwant = vraag.id ? (verwanten.get(vraag.id) ?? []) : [];

// De papersectie als kopregel boven de vraag, want daar is de lijst op
// gesorteerd. Zonder sectie zegt de kopregel dat.
const kopregel = vraag.paper
  ? `§ ${vraag.paper.nummer} ${vraag.paper.titel}`
  : 'Zonder sectie in het paper';

const tickets: MiniTicket[] = vraag.deelvragen.map((d) => {
  const stand = deelvraagLane(d, lane);
  return {
    tekst: d.vraag,
    lane: stand.lane,
    eigen: stand.eigen,
    bron: 'vraag',
    status: d.status,
    onder: d.doel ? `Doel: ${d.doel}` : undefined,
  };
});
---

<nldd-list
  type="tree"
  appearance="box-tinted"
  accessible-label={vraag.vraag}
  data-lane={lane}
  data-zoek={vraagZoektekst(vraag, werkpakket)}
  data-paragraaf={paragraaf}
>
<nldd-list-item data-uitklap>
  {/* Een gesegmenteerde rij: eerst de link naar het paper, dan een knop die
      het werkpakket opent in een paneel over de helft van het scherm
      (RoadmapWerkpakketPaneel), en dan de vraag met zijn tags als de knop die
      uitklapt. De plek in het paper en het werkpakket staan vooraan omdat ze
      zeggen waar de vraag bij hoort, en de lijst is op het paper gesorteerd.
      Zo is alles op de tegel klikbaar zonder een link in een knop te
      stoppen; het ontwerpsysteem geeft elk segment zijn eigen hit-area en
      focus, en zet aria-expanded op het disclosure-segment. */}
  {/* Vaste breedtes (roadmap.css, .rr-vraag__veld), zodat de twee velden op
      elke kaart onder elkaar staan. Een vraag zonder sectie houdt dezelfde
      plek vrij, met een tekst die dat zegt, anders schuift zijn werkpakket
      een kolom naar links. */}
  {!vraag.paper && (
    <nldd-list-item-segment class="rr-vraag__veld rr-vraag__veld--paper">
      <nldd-text-cell overline="Position paper" text="Geen sectie" />
    </nldd-list-item-segment>
  )}
  {vraag.paper && (
    <nldd-list-item-segment class="rr-vraag__veld rr-vraag__veld--paper" href={vraag.paper.href} accessible-label={`Position paper, Rules as Executed paragraaf ${vraag.paper.nummer}`}>
      <nldd-text-cell overline="Position paper" text={`Rules as Executed § ${vraag.paper.nummer}`} />
    </nldd-list-item-segment>
  )}
  <nldd-list-item-segment class="rr-vraag__veld rr-vraag__veld--werkpakket" button data-open-werkpakket={werkpakket.id} accessible-label={`Werkpakket ${werkpakket.titel} openen`}>
    <nldd-text-cell overline="Werkpakket" text={werkpakket.titel} />
  </nldd-list-item-segment>
  <nldd-list-item-segment button disclosure width="full" accessible-label={`${vraag.vraag}, user stories en deelvragen tonen`}>
    <nldd-text-cell overline={kopregel} text={vraag.vraag} width="full">
      <nldd-container slot="supporting-text" layout="wrap" gap="4" vertical-alignment="center">
        {/* De eigen status als tag; zonder eigen status de belegging van het
            werkpakket, met "werkpakket" ervoor, want daar komt de stand dan
            vandaan. Vrij krijgt geen tag, net als op de werkpakketkaart. */}
        {status && <nldd-tag size="sm" color={status.tagColor} text={status.label} />}
        {!status && belegging && belegging.id !== 'vrij' && (
          <nldd-tag
            size="sm"
            color={belegging.tagColor}
            text={`werkpakket ${belegging.label.toLowerCase()}`}
            icon={belegging.id === 'klaar' ? 'done' : 'user'}
          />
        )}
        {tags.map((tag) => (
          <nldd-tag
            size="sm"
            color={tag.color}
            text={tag.text}
            icon={tag.icon}
            accessible-label={tag.label}
          />
        ))}
        {rfcs && <nldd-text size="xs" color="secondary">{rfcs}</nldd-text>}
        {/* De telling van de stories op de kaart zelf, zodat je zonder
            uitklappen ziet welke vragen al concreet zijn gemaakt. */}
        {vraag.stories.length > 0 && (
          <nldd-text size="xs" color="secondary">{storiesTekst(vraag.stories.length)}</nldd-text>
        )}
      </nldd-container>
    </nldd-text-cell>
    <nldd-icon-cell size="20" icon="chevron-right" disclosure />
  </nldd-list-item-segment>

  <nldd-list-item slot="children">
    <nldd-spacer-cell />
    <nldd-cell width="full" vertical-alignment="top">
      <nldd-container gap="16">
        {!eigen && belegging && belegging.id !== 'vrij' && (
          <nldd-container gap="2">
            <nldd-text size="xs" weight="medium" color="secondary">Stand</nldd-text>
            <nldd-text size="sm" color="secondary">
              {belegging.label}, overgenomen van het werkpakket
            </nldd-text>
          </nldd-container>
        )}

        {vraag.doel && (
          <nldd-container gap="2">
            <nldd-text size="xs" weight="medium" color="secondary">Doel</nldd-text>
            <nldd-text size="sm">{vraag.doel}</nldd-text>
          </nldd-container>
        )}

        <nldd-container gap="4">
          <nldd-text size="xs" weight="medium" color="secondary">User stories</nldd-text>
          <RoadmapStoryLijst stories={vraag.stories} ouderLane={lane} />
        </nldd-container>

        <nldd-container gap="4">
          <nldd-text size="xs" weight="medium" color="secondary">Deelvragen</nldd-text>
          <RoadmapMiniBord tickets={tickets} />
        </nldd-container>

        {verwant.length > 0 && (
          <nldd-container gap="2">
            <nldd-text size="xs" weight="medium" color="secondary">Verwante vragen</nldd-text>
            <nldd-list type="navigation" appearance="box-base">
              {verwant.map((v) => (
                <nldd-list-item href={v.href}>
                  <nldd-text-cell text={v.vraag} supporting-text={v.werkpakketTitel} width="full" />
                  <nldd-spacer-cell />
                  <nldd-icon-cell size="20" icon="chevron-right" />
                </nldd-list-item>
              ))}
            </nldd-list>
          </nldd-container>
        )}
      </nldd-container>
    </nldd-cell>
  </nldd-list-item>
</nldd-list-item>
</nldd-list>
