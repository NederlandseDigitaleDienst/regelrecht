{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "domain",
    "image",
    "case",
    "regelhet"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "host": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "image": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "repoUrl",
        "ref",
        "path"
      ],
      "properties": {
        "repoUrl": {
          "type": "string",
          "pattern": "^https://[^@/]+/.+"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^-\\s][^\\s]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*$"
        },
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^([a-z0-9][a-z0-9_-]*)?$"
        },
        "credentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "configMaps": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    },
    "regelhet": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "test",
            "stable"
          ]
        },
        "surface": {
          "enum": [
            "all",
            "burger",
            "backoffice"
          ]
        },
        "login": {
          "enum": [
            "testlogin",
            "oidc"
          ]
        },
        "subjectClaim": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "not": {
        "required": [
          "store"
        ]
      }
    },
    "tls": {
      "type": "object",
      "required": [
        "acme"
      ],
      "properties": {
        "acme": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "email": {
          "type": "string"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "serviceAnnotations": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "listenerSet",
            "shared",
            "own"
          ]
        },
        "shared": {
          "type": "object",
          "required": [
            "name",
            "namespace",
            "httpListener",
            "tlsListener"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "httpListener": {
              "type": "string",
              "minLength": 1
            },
            "tlsListener": {
              "type": "string",
              "minLength": 1
            },
            "clusterIssuer": {
              "type": "string"
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "imageCatalog": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "ClusterImageCatalog",
                "ImageCatalog"
              ]
            },
            "name": {
              "type": "string"
            },
            "major": {
              "type": "integer",
              "minimum": 13
            }
          }
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 2
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "split": {
          "type": "boolean"
        },
        "burger": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        },
        "backoffice": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fsc4b": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[A-Za-z0-9.:\\[\\]-]+$"
          }
        }
      }
    },
    "voorkant": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/definitions/objectIdOrEmpty"
        },
        "naam": {
          "type": "string"
        },
        "logo": {
          "type": "string",
          "pattern": "^$|^https://[^\\s]+$"
        },
        "processen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "naam",
              "burger",
              "backoffice"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/objectId"
              },
              "naam": {
                "type": "string",
                "minLength": 1
              },
              "burger": {
                "$ref": "#/definitions/procesSide"
              },
              "backoffice": {
                "$ref": "#/definitions/procesSide"
              }
            }
          }
        },
        "keyImage": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        }
      }
    },
    "organisatie": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/objectIdOrEmpty"
        },
        "naam": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^$|^https://[^\\s/]+/?$"
        },
        "medewerkersUrl": {
          "type": "string",
          "pattern": "^$|^https://[^\\s/]+/?$"
        },
        "sleutelUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$"
        },
        "sleutelJwk": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accentColor": {
          "enum": [
            "",
            "bruin",
            "donkerblauw",
            "donkerbruin",
            "donkergeel",
            "donkergroen",
            "geel",
            "groen",
            "hemelblauw",
            "lichtblauw",
            "mintgroen",
            "mosgroen",
            "oranje",
            "paars",
            "robijnrood",
            "rood",
            "roze",
            "violet"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(\\S([^\\x00-\\x1f\\x7f]*\\S)?)?$"
        }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuerUrl": {
          "type": "string",
          "pattern": "^(https://[^\\s]+/realms/[^/\\s]+)?$"
        },
        "requiredRole": {
          "type": "string",
          "pattern": "^regelhet-"
        },
        "existingSecret": {
          "type": "string"
        },
        "clients": {
          "type": "object",
          "required": [
            "burger",
            "backoffice"
          ],
          "properties": {
            "burger": {
              "type": "object",
              "required": [
                "clientId",
                "secretKey"
              ],
              "properties": {
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              }
            },
            "backoffice": {
              "type": "object",
              "required": [
                "clientId",
                "secretKey"
              ],
              "properties": {
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              }
            }
          }
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "image": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "testUsers": {
          "type": "boolean"
        },
        "testPasswordKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[-._a-zA-Z0-9]+$"
        },
        "database": {
          "type": "object",
          "properties": {
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "storage": {
              "type": "object",
              "required": [
                "size"
              ],
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi|Ti)$"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "secretsJob": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "pullPolicy": {
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            }
          }
        },
        "realmImport": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "keycloakCRName": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          }
        },
        "testApplicants": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "username",
              "number"
            ],
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,254}$"
              },
              "number": {
                "type": "string",
                "pattern": "^[0-9A-Za-z]{1,64}$"
              },
              "name": {
                "type": "string",
                "maxLength": 255
              }
            }
          }
        }
      }
    },
    "koppeling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partij": {
          "type": "string"
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cel",
              "url"
            ],
            "properties": {
              "cel": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "sleutel": {
                "type": "object"
              },
              "grantHash": {
                "type": "string",
                "pattern": "^[!-~]+$"
              },
              "voorkant": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "keySecret": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "objectIdOrEmpty": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?/[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "procesSide": {
      "type": "object",
      "required": [
        "intern",
        "publiek"
      ],
      "properties": {
        "intern": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(:[0-9]+)?/?$"
        },
        "publiek": {
          "type": "string",
          "pattern": "^https://[^\\s/]+/?$"
        }
      }
    }
  }
}
