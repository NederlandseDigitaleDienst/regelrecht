{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "domain",
    "image",
    "case",
    "wetsproces"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "host": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "image": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "repoUrl",
        "ref",
        "path"
      ],
      "properties": {
        "repoUrl": {
          "type": "string",
          "pattern": "^https://[^@/]+/.+"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^-\\s][^\\s]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*$"
        }
      }
    },
    "wetsproces": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "test"
        },
        "surface": {
          "enum": [
            "all",
            "burger",
            "backoffice"
          ]
        },
        "login": {
          "const": "testlogin"
        }
      },
      "not": {
        "required": [
          "store"
        ]
      }
    },
    "tls": {
      "type": "object",
      "required": [
        "acme"
      ],
      "properties": {
        "acme": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "email": {
          "type": "string"
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "serviceAnnotations": {
          "type": "object"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "imageCatalog": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "ClusterImageCatalog",
                "ImageCatalog"
              ]
            },
            "name": {
              "type": "string"
            },
            "major": {
              "type": "integer",
              "minimum": 13
            }
          }
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 2
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "properties": {
        "split": {
          "type": "boolean"
        },
        "burger": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        },
        "backoffice": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accentColor": {
          "enum": [
            "",
            "bruin",
            "donkerblauw",
            "donkerbruin",
            "donkergeel",
            "donkergroen",
            "geel",
            "groen",
            "hemelblauw",
            "lichtblauw",
            "mintgroen",
            "mosgroen",
            "oranje",
            "paars",
            "robijnrood",
            "rood",
            "roze",
            "violet"
          ]
        }
      }
    }
  }
}
