# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Claude Code
.claude/settings.local.json
.claude/*.local.*

# Logs
*.log

# Git worktrees
.worktrees/

# Browser automation artifacts (Playwright MCP / e2e smoke screenshots).
# The MCP server writes snapshots/screenshots here; keep them out of git.
.playwright-mcp/
.screenshots/

# Frontend
node_modules/
frontend/dist/
frontend/public/wasm/pkg/
frontend-poc-portal/dist/
packages/admin/static/

# Landing page: the engine and the laws it needs are copied in by
# `just wasm-build` and `just landing-laws`, out of the build and the corpus.
# Both are generated, so neither belongs in git.
docs/public/wasm/
docs/public/laws/
docs/src/lib/gherkin/

# PoC-frontends: alles wat copy-assets.js in public/ neerzet komt uit
# corpus-poc/ en de wasm-build, en hoort dus niet ook in git.
frontend-poc-*/dist/
frontend-poc-*/public/laws/
frontend-poc-*/public/data/
frontend-poc-*/public/wasm/
# chronolexografie: de app staat naast haar crate, in één map.
packages/poc-chronolexografie/frontend/dist/
packages/poc-chronolexografie/frontend/public/wasm/
packages/poc-chronolexografie/frontend/public/bundel.json
packages/poc-chronolexografie/frontend/public/bronnen.json

# De opgenomen rondleiding: ruwe opnames en tussenbestanden blijven lokaal,
# de video's gaan via een GitHub-release (zie script/walkthrough/).
.walkthrough/
frontend-demo/public/walkthrough/

# PoC-portaal: wat `just poc` lokaal samenstelt om te serveren.
.poc-static/
.poc-shot.sh

# Rust
target/
**/*.rs.bk
*.pdb
# Generated by `just dev-setup`: machine-local cargo config (shared target-dir,
# optional sccache wrapper). packages/.cargo/config.toml stays tracked.
/.cargo/

# Python (pre-commit uses a venv)
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
.ruff_cache/

# Mutation testing. cargo-mutants hernoemt de vorige uitvoer bij een herrun
# naar mutants.out.old/, en die naam matcht het patroon hierboven niet.
mutants.out*/

# BDD trace output
trace_output/

# Core dump van de headless Chromium die de frontend-tests en de docs-build
# aansturen. `kernel.core_pattern` staat op de kale naam `core`, dus zo'n dump
# landt in de werkmap van het proces. Geankerd op deze ene plek, want een kaal
# `core` zou ook elke toekomstige map met die naam wegnemen.
/frontend/core

# Architecture model — generated on-demand by `arch-extract` for the local
# architecture explorer (`just arch-generate`). Never committed: the explorer
# regenerates it from the working tree, so it is always current by construction.
docs/src/content/architecture/model.json

# Dev stack
.dev-pids

# Corpus local overrides
corpus-registry.local.yaml
corpus-auth.yaml

# Environment — ignore all .env files, keep the committed *.example templates
.env*
!.env*.example
# Local SSO secrets (no leading dot, so .env* above misses it)
env.sso-local

# Gemini CLI
.gemini/*
!.gemini/prompts/

# Beads
.beads/
.relanding-ref/

# Leak-guard laag 2 — casus-/sector-patronen blijven lokaal (zie script/check-skills-no-casus.sh)
script/.skills-casus-denylist.local

# Lokale DS-tarballs voor het testen van een storybook-branch (niet committen)
.ds-tarballs/
sync-ds.sh
